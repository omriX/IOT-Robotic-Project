Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.25
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry Trail
      Enabled: true
      Topic:
        Value: /odom
      Keep: 30
      Position Tolerance: 0.01
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Color: 255; 210; 0
        Shaft Length: 0.05
        Shaft Radius: 0.006
        Head Length: 0.02
        Head Radius: 0.015
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Traveled Path
      Enabled: true
      Topic:
        Value: /path
      Line Style: Lines
      Color: 0; 200; 255
      Alpha: 1
      Buffer Length: 1
      Value: true
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 260
      X: 0
      Y: 0
      Value: TopDownOrtho (rviz_default_plugins)
Window Geometry:
  Height: 800
  Width: 1200
